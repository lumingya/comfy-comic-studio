# Keep Windows launchers usable after Git checkout on any platform.
*.bat text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf

# Distribution checksums are computed over stable UTF-8 bytes.
*.json text eol=lf

# Generated bundles preserve whitespace inside upstream CSS template strings.
extensions/ai-assist/page/dist/assets/*.js whitespace=-blank-at-eol
