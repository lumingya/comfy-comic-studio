{
  "id": "qa-review",
  "name": "智能质检与辅助挑图",
  "version": "1.0.0",
  "description": "逐幕审阅真实 VLM 评分和问题清单，保留创作者的采用选择。",
  "contributes": {
    "panels": [
      {
        "id": "review",
        "slot": "episode",
        "title": "候选评审",
        "entry": "panel.html",
        "requests": [
          {
            "id": "episode",
            "method": "GET",
            "path": "/episodes/{episode_id}",
            "scope": "read"
          },
          {
            "id": "review",
            "method": "POST",
            "path": "/episodes/{episode_id}/qa",
            "scope": "render"
          },
          {
            "id": "job",
            "method": "GET",
            "path": "/jobs/{job_id}",
            "scope": "read"
          }
        ]
      }
    ]
  }
}
