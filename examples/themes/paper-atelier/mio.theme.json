{
  "id": "paper-atelier",
  "name": "纸间 · 手作工坊",
  "version": "2.0.0",
  "apiVersion": 2,
  "description": "SDK v2 参考主题：一份主题包同时定义深色/浅色两套令牌、共享的纸纹材质、阅读室与终端配色，以及一组手绘风图标。跟随宿主的明暗切换。",
  "css": "theme.css",
  "variants": {
    "dark": "dark.css",
    "light": "light.css"
  },
  "tokens": {
    "shared": {
      "--sans": "Georgia,'Songti SC','Noto Serif SC',serif",
      "--art-serif": "'Songti SC','Noto Serif SC',Georgia,serif",
      "--glass-rgb": "255 250 240",
      "--star": "#d9a441",
      "--paper": "#f3ead8",
      "--paper-ink": "#3b3325",
      "--paper-muted": "#8c8068",
      "--paper-shade": "#e0cfae"
    },
    "light": {
      "--bg": "#f4eee2",
      "--side": "#e9e1d0",
      "--panel": "#fbf6ea",
      "--panel2": "#e8dfcb",
      "--hover": "#e3d8c2",
      "--line": "#d0c2a7",
      "--text": "#3a3327",
      "--soft": "#635d4d",
      "--muted": "#857a65",
      "--accent": "#876241",
      "--accent2": "#916c43",
      "--on-accent": "#fff8e6",
      "--tint": "#e2d6bc",
      "--shadow-rgb": "60 40 10",
      "--terminal-bg": "#efe6d3",
      "--terminal-text": "#4a4132",
      "--terminal-muted": "#7d7159",
      "--terminal-dim": "#9a8f78",
      "--reader-bg": "#2a241c",
      "--reader-surface": "#342d23",
      "--reader-line": "#4a4133",
      "--reader-text": "#f1e8d6",
      "--reader-soft": "#cbbfa6",
      "--reader-muted": "#9f937b",
      "--cover-bg": "#5a4b38"
    },
    "dark": {
      "--bg": "#1a1611",
      "--side": "#1f1a14",
      "--panel": "#252019",
      "--panel2": "#2e281f",
      "--hover": "#37301f",
      "--line": "#3d3527",
      "--text": "#efe6d3",
      "--soft": "#c4b89f",
      "--muted": "#a5987e",
      "--accent": "#e0b068",
      "--accent2": "#c1924f",
      "--on-accent": "#221a0e",
      "--tint": "#3b3021",
      "--shadow-rgb": "0 0 0",
      "--terminal-bg": "#15120d",
      "--terminal-text": "#c9bb9b",
      "--terminal-muted": "#8f8267",
      "--terminal-dim": "#6c6251",
      "--reader-bg": "#141109",
      "--reader-surface": "#1c1811",
      "--reader-line": "#2f2919",
      "--reader-text": "#efe6d3",
      "--reader-soft": "#c4b89f",
      "--reader-muted": "#8f8267",
      "--cover-bg": "#3a3024"
