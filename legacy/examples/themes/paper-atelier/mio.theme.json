{
  "id": "paper-atelier",
  "name": "纸间 · 手作工坊",
  "version": "3.0.0",
  "apiVersion": 3,
  "description": "SDK v3 参考主题：一份主题包同时定义深色/浅色两套令牌、共享纸纹材质、可选的\"泛黄旧稿\"外观（自定义 variant）、可在样式工坊里实时调节的设置项，以及一段随主题加载的脚本。可与其他主题叠加。",
  "css": "theme.css",
  "variants": {
    "dark": "dark.css",
    "light": "light.css",
    "sepia": "sepia.css"
  },
  "tokens": {
    "shared": {
      "--sans": "Georgia,'Songti SC','Noto Serif SC',serif",
      "--art-serif": "'Songti SC','Noto Serif SC',Georgia,serif",
      "--glass-rgb": "255 250 240",
      "--star": "#d9a441",
      "--paper": "#f3ead8",
      "--paper-ink": "#3b3325",
      "--paper-muted": "#8c8068",
      "--paper-shade": "#e0cfae"
    },
    "light": {
      "--bg": "#f4eee2",
      "--side": "#e9e1d0",
      "--panel": "#fbf6ea",
      "--panel2": "#e8dfcb",
      "--hover": "#e3d8c2",
      "--line": "#d0c2a7",
      "--text": "#3a3327",
      "--soft": "#635d4d",
      "--muted": "#857a65",
      "--accent": "#876241",
      "--accent2": "#916c43",
      "--on-accent": "#fff8e6",
      "--tint": "#e2d6bc",
      "--shadow-rgb": "60 40 10",
      "--terminal-bg": "#efe6d3",
      "--terminal-text": "#4a4132",
      "--terminal-muted": "#7d7159",
      "--terminal-dim": "#9a8f78",
      "--reader-bg": "#2a241c",
      "--reader-surface": "#342d23",
      "--reader-line": "#4a4133",
      "--reader-text": "#f1e8d6",
      "--reader-soft": "#cbbfa6",
      "--reader-muted": "#9f937b",
      "--cover-bg": "#5a4b38"
    },
    "dark": {
      "--bg": "#1a1611",
      "--side": "#1f1a14",
      "--panel": "#252019",
      "--panel2": "#2e281f",
      "--hover": "#37301f",
      "--line": "#3d3527",
      "--text": "#efe6d3",
      "--soft": "#c4b89f",
      "--muted": "#a5987e",
      "--accent": "#e0b068",
      "--accent2": "#c1924f",
      "--on-accent": "#221a0e",
      "--tint": "#3b3021",
      "--shadow-rgb": "0 0 0",
      "--terminal-bg": "#15120d",
      "--terminal-text": "#c9bb9b",
      "--terminal-muted": "#8f8267",
      "--terminal-dim": "#6c6251",
      "--reader-bg": "#141109",
      "--reader-surface": "#1c1811",
      "--reader-line": "#2f2919",
      "--reader-text": "#efe6d3",
      "--reader-soft": "#c4b89f",
      "--reader-muted": "#8f8267",
      "--cover-bg": "#3a3024"
    },
    "sepia": {
      "--bg": "#efe1c4",
      "--side": "#e4d3b1",
      "--panel": "#f6ead0",
      "--panel2": "#e8d8b5",
      "--hover": "#dfcda7",
      "--line": "#c8b48b",
      "--text": "#4a3a22",
      "--soft": "#6f5d40",
      "--muted": "#8d7a58",
      "--accent": "#9a5a2a",
      "--accent2": "#b0713b",
      "--on-accent": "#fff6e3",
      "--tint": "#dcc9a3",
      "--shadow-rgb": "70 45 10"
    }
  },
  "icons": "icons.json",
  "colorScheme": "auto",
  "variantLabels": {
    "sepia": "泛黄旧稿"
  },
  "settings": [
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "var": "--accent",
      "default": "",
      "help": "留空时使用主题自带的深浅色配色"
    },
    {
      "key": "paperOpacity",
      "label": "纸纹强度",
      "type": "range",
      "var": "--paper-opacity",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1
    },
    {
      "key": "radius",
      "label": "卡片圆角",
      "type": "range",
      "var": "--paper-radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "key": "headingFont",
      "label": "标题字体",
      "type": "font",
      "var": "--art-serif",
      "default": "'Songti SC','Noto Serif SC',Georgia,serif"
    },
    {
      "key": "stamp",
      "label": "角落印章",
      "type": "toggle",
      "default": true,
      "help": "由 theme.js 在页面右下角盖一枚朱印"
    }
  ],
  "script": "theme.js"
}
