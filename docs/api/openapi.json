  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "GenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt"
        ],
        "oneOf": [
          {
            "required": [
              "providerId"
            ],
            "not": {
              "required": [
                "config"
              ]
            }
          },
          {
            "required": [
              "config"
            ],
            "not": {
              "required": [
                "providerId"
              ]
            }
          }
        ],
        "properties": {
          "providerId": {
            "type": "string"
          },
          "config": {
            "$ref": "#/components/schemas/ProviderConfig"
          },
          "apiKey": {
            "type": "string",
            "writeOnly": true
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "negative": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "PNG, JPEG or WebP base64 data URL"
          },
          "frame": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "steps": {
                "type": "number"
              },
              "cfg": {
                "type": "number"
              },
              "seed": {
                "type": "number"
              },
              "denoise": {
                "type": "number"
              }
            }
          }
        }
      },
      "ProviderConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "baseUrl",
          "model"
        ],
        "properties": {
          "baseUrl": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "quality": {
            "type": "string"
          },
          "sampler": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "novelai",
              "openai"
            ]
          },
          "protocol": {
            "enum": [
              "images",
              "chat"
            ]
          },
          "sendSize": {
            "type": "boolean"
          },
          "sendQuality": {
            "type": "boolean"
          },
          "keyId": {
            "type": "string"
          },
          "keyMode": {
            "enum": [
              "none",
              "stored",
              "environment"
            ]
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Provider": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          }
        }
      },
      "Album": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "totalSteps": {
            "type": "number"
          },
          "generatedSteps": {
            "type": "number"
          },
          "updatedAt": {
            "type": "number"
          }
        }
      },
      "Storyboard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "negative": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "steps": {
                  "type": "number"
                },
                "cfg": {
                  "type": "number"
                },
                "seed": {
                  "type": "number"
                },
                "denoise": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "GenerationResult": {
        "type": "object",
        "required": [
          "image",
          "provider",
          "offlineFallback",
