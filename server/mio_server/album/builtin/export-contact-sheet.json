{
  "id": "export-contact-sheet",
  "formatVersion": 1,
  "title": "电影分镜 · Contact Sheet",
  "description": "暗房胶片联系表式画册：一眼浏览全话的光影节奏，点击任一格即可进入原生大图精读。",
  "author": "Mio",
  "version": "1.0.0",
  "layout": "contact",
  "options": {
    "accent": "#d59a55",
    "background": "#17191a",
    "paper": "#252829",
    "text": "#f0ece2",
    "width": 1440,
    "gap": 18,
    "radius": 0,
    "font": "sans"
  },
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{collectionTitle}}</title><style>\n:root{--accent:{{themeColor}};--paper:{{paperColor}};--ink:{{textColor}};--canvas:{{background}};--line:color-mix(in srgb,var(--ink) 22%,transparent)}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--canvas);color:var(--ink);font-family:{{bodyFont}};-webkit-font-smoothing:antialiased}figure{margin:0}p{white-space:pre-line}h1,h2,p{overflow-wrap:anywhere}::selection{background:var(--accent);color:#17191a}\n.edition-heading p:empty,.edition-heading .signature:empty,.caption-text:empty,.prompt:empty,.image-note:empty{display:none}.prompt{white-space:pre-wrap;overflow-wrap:anywhere;font:10px/1.7 ui-monospace,monospace;opacity:.6;margin:10px 0 0}.image-note{display:block;font:10px/1.6 system-ui,sans-serif;margin-top:7px;opacity:.6}.cc-image{display:block;width:auto;height:auto;max-width:100%;max-height:none;object-fit:contain;margin-inline:auto;cursor:zoom-in}.cc-image:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.colophon{font:9px/1.8 ui-monospace,monospace;letter-spacing:.12em;font-variant-numeric:tabular-nums}.cc-blank{min-height:240px}\n@media print{html{scroll-behavior:auto}body{background:#fff;color:#17191a}.contact-book{max-width:none!important;margin:0!important;padding:0!important}.contact-sheet{grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.frame{break-inside:avoid;background:#fff!important;border-color:#777!important;box-shadow:none!important}.film-rail,.film-stamp{print-color-adjust:exact}.cc-image{max-height:none}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}\n.contact-book{max-width:{{contentWidth}}px;margin:0 auto;padding:28px clamp(14px,3vw,44px) 110px}.edition-heading{position:relative;padding:24px clamp(16px,3vw,38px) 22px;border-block:1px solid var(--accent);background:linear-gradient(110deg,#0004,transparent 58%)}.edition-heading:before{content:'';position:absolute;inset:0 auto 0 0;width:4px;background:var(--accent)}.topline{display:flex;justify-content:space-between;gap:16px;color:var(--accent)}.edition-heading h1{font-size:clamp(24px,4vw,44px);font-weight:500;line-height:1.35;letter-spacing:.035em;margin:16px 0 8px}.synopsis{max-width:58em;color:color-mix(in srgb,var(--ink) 70%,transparent);font-size:13px;line-height:1.8;margin:0}.signature{font:11px/1.8 system-ui,sans-serif;color:var(--accent);margin:12px 0 0}.sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:24px 0 12px;padding:0 0 8px;border-bottom:1px solid var(--line);color:var(--accent);font:10px/1.7 ui-monospace,monospace;letter-spacing:.08em}.sheet-heading strong{font-weight:500}.sheet-heading span:last-child{font-variant-numeric:tabular-nums}.contact-sheet{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:{{panelGap}}px;align-items:stretch}.frame{position:relative;min-width:0;overflow:hidden;background:var(--paper);border:1px solid color-mix(in srgb,var(--accent) 42%,transparent);box-shadow:0 5px 18px #0003}.film-rail{position:absolute;z-index:2;inset:0 auto 0 0;width:11px;display:flex;flex-direction:column;justify-content:space-around;padding:7px 2px;background:color-mix(in srgb,var(--accent) 18%,var(--paper));border-right:1px solid color-mix(in srgb,var(--accent) 42%,transparent);pointer-events:none}.film-rail i{display:block;width:6px;height:10px;border:1px solid color-mix(in srgb,var(--accent) 70%,transparent);border-radius:1px}.frame-content{min-width:0;padding:10px 11px 11px 18px}.film-stamp{display:flex;justify-content:space-between;gap:8px;margin-bottom:8px;color:var(--accent);font:9px/1.6 ui-monospace,monospace;font-variant-numeric:tabular-nums}.film-stamp span:first-child{overflow-wrap:anywhere}.art{display:grid;place-items:center;min-height:132px;padding:8px;background:#090b0c;border:1px solid #ffffff12}.cc-image{max-height:220px}.caption{padding-top:9px}.caption-head{display:flex;justify-content:space-between;gap:10px;align-items:baseline}.caption h2{min-width:0;font-size:12px;font-weight:600;line-height:1.6;margin:0;color:var(--accent)}.shot-size{flex:none;color:color-mix(in srgb,var(--ink) 60%,transparent);font:9px/1.5 ui-monospace,monospace;font-variant-numeric:tabular-nums}.caption-text{font-size:11px;line-height:1.8;margin:5px 0 0;color:color-mix(in srgb,var(--ink) 83%,transparent)}.caption .prompt,.caption .image-note{grid-column:1/-1}.colophon{text-align:right;color:var(--accent);margin-top:22px;padding-top:11px;border-top:1px solid var(--line)}\n@media(max-width:680px){.contact-book{padding:16px 12px 96px}.edition-heading{padding:18px 16px 16px}.topline{font-size:8px;letter-spacing:.06em}.edition-heading h1{margin-top:13px}.sheet-heading{font-size:9px;margin-top:18px}.contact-sheet{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.frame-content{padding:8px 7px 9px 15px}.film-rail{width:9px}.film-rail i{width:5px;height:8px}.art{min-height:104px;padding:5px}.cc-image{max-height:160px}.film-stamp{font-size:8px}.caption h2{font-size:11px}.caption-text{font-size:10px}.shot-size{font-size:8px}}\n@media(max-width:360px){.contact-sheet{grid-template-columns:1fr}.cc-image{max-height:220px}}\n</style></head><body>{{#books}}<article class=\"contact-book\" data-cc-book><header class=\"edition-heading\"><div class=\"topline colophon\"><span>CONTACT SHEET / 分镜联系表</span><span>{{date}} · {{panelCount}} CUTS</span></div><h1>{{title}}</h1><p class=\"synopsis\">{{synopsis}}</p><p class=\"signature\">{{signature}}</p></header><div class=\"sheet-heading\"><strong>全片缩略总览</strong><span>点击画格进入大图精读</span></div><main class=\"contact-sheet\" data-cc-pages>{{#frames}}<figure class=\"frame\" data-cc-frame><div class=\"film-rail\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i></div><div class=\"frame-content\"><div class=\"film-stamp\" data-mio-label><span>{{number}} / {{total}}</span><span>FRAME {{number}}</span></div><div class=\"art\"><img class=\"cc-image\" src=\"{{image}}\" alt=\"{{name}}\" loading=\"lazy\" decoding=\"async\"></div><figcaption class=\"caption\" data-cc-caption><div class=\"caption-head\"><h2>{{name}}</h2><span class=\"shot-size\">{{width}} × {{height}}</span></div><p class=\"caption-text\">{{caption}}</p><pre class=\"prompt\" data-cc-prompt>{{prompt}}</pre><small class=\"image-note\">{{imageNote}}</small></figcaption></div></figure>{{/frames}}</main><footer class=\"colophon\">{{title}} · MIO CONTACT PRINT</footer></article>{{/books}}</body></html>",
  "assets": {}
}
