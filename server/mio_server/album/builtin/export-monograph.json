{
  "id": "export-monograph",
  "formatVersion": 1,
  "title": "典藏画集 · Monograph",
  "description": "暖白棉纸、卡纸画框与双栏作品铭牌。完整呈现每一幅画，把阅读留给故事。",
  "author": "Mio",
  "version": "3.0.0",
  "layout": "gallery",
  "options": {
    "accent": "#8b5a3c",
    "background": "#f5f1e9",
    "paper": "#fcfbf7",
    "text": "#1a1816",
    "width": 1080,
    "gap": 48,
    "radius": 0,
    "font": "serif"
  },
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{collectionTitle}}</title><style>\n:root{--accent:{{themeColor}};--paper:{{paperColor}};--ink:{{textColor}};--canvas:{{background}};--line:color-mix(in srgb,var(--ink) 20%,transparent)}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--canvas);color:var(--ink);font-family:{{bodyFont}};-webkit-font-smoothing:antialiased}figure{margin:0}p{white-space:pre-line}h1,h2,p{overflow-wrap:anywhere}h1,h2{font-weight:400}::selection{background:var(--accent);color:var(--paper)}\n.edition-heading h1{text-wrap:balance}.edition-heading p:empty,.edition-heading .signature:empty,.caption-text:empty,.image-note:empty,.prompt:empty{display:none}.prompt{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.8 ui-monospace,monospace;opacity:.65;margin:16px 0 0}.image-note{display:block;font:11px/1.6 system-ui,sans-serif;margin-top:10px;opacity:.6}.cc-image{display:block;width:auto;height:auto;max-width:100%;max-height:none;object-fit:contain;margin-inline:auto;border:{{frameBorder}}px solid var(--accent);border-radius:{{imageRadius}}px;cursor:zoom-in}.cc-image:focus-visible{outline:2px solid var(--accent);outline-offset:5px}.palette{display:flex;gap:5px}.palette i{display:block;width:8px;height:8px;flex:none}.colophon{font:10px/1.8 system-ui,sans-serif;letter-spacing:.14em}.cc-blank{min-height:240px;opacity:1;color:color-mix(in srgb,var(--ink) 25%,transparent)}\n@media print{html{scroll-behavior:auto}body{background:white;color:#1a1816}.book{max-width:none!important;margin:0!important}.frame{break-inside:avoid}.edition-heading{break-after:avoid}.cc-image{max-height:none}.palette i{print-color-adjust:exact}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}\n\n.book{max-width:{{contentWidth}}px;margin:0 auto;padding:0 clamp(18px,4vw,56px) 130px}.edition-heading{padding:48px 0 46px;border-top:3px solid var(--ink);margin-top:32px}.topline{display:flex;justify-content:space-between;gap:18px;padding-bottom:18px;border-bottom:1px solid var(--accent);color:var(--accent)}.edition-heading h1{font-size:clamp(26px,4vw,48px);line-height:1.4;letter-spacing:.025em;margin:28px 0 18px}.synopsis{font-size:14px;line-height:2;max-width:44em;opacity:.72;margin:0}.signature{font:12px/1.8 system-ui,sans-serif;margin-top:20px;color:var(--accent)}.pages{display:grid;gap:{{panelGap}}px}.frame{min-width:0}.art{padding:clamp(18px,4vw,48px);background:var(--paper);border:1px solid color-mix(in srgb,var(--ink) 9%,transparent);box-shadow:0 8px 24px #1a181608}.caption{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px 32px;margin:0 0 4px;padding:21px 0 0}.label{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;align-content:start}.index{font:10px/1.7 ui-monospace,monospace;color:var(--accent);padding-top:3px}.label h2{font-size:14px;line-height:1.7;margin:0}.caption-text{font-size:13px;line-height:1.95;margin:0}.palette{grid-column:2;margin-top:2px}.caption .prompt,.caption .image-note{grid-column:1/-1}footer.colophon{text-align:right;margin-top:48px;padding-top:18px;border-top:1px solid var(--line);color:var(--accent)}\n@media(max-width:680px){.book{padding-inline:18px;padding-bottom:120px}.edition-heading{margin-top:20px;padding-top:26px;padding-bottom:30px}.topline{font-size:9px;letter-spacing:.08em}.edition-heading h1{margin-block:24px 14px}.pages{gap:32px}.caption{grid-template-columns:1fr;gap:12px;padding-top:16px}.caption-text{padding-left:40px}.palette{grid-column:1;padding-left:40px}.art{padding:16px}.signature{margin-top:14px}}\n</style></head><body>{{#books}}<article class=\"book monograph\" data-cc-book data-mio-curated-edition><header class=\"edition-heading\"><div class=\"topline colophon\"><span>MONOGRAPH / 典藏画集</span><span>{{date}} · {{panelCount}} 幕</span></div><h1>{{title}}</h1><p class=\"synopsis\">{{synopsis}}</p><p class=\"signature\">{{signature}}</p></header><main class=\"pages\" data-cc-pages>{{#frames}}<figure class=\"frame\" data-cc-frame><div class=\"art\"><img class=\"cc-image\" src=\"{{image}}\" alt=\"{{name}}\" loading=\"lazy\" decoding=\"async\"></div><figcaption class=\"caption\" data-cc-caption><div class=\"label\"><span class=\"index\">{{number}}</span><h2>{{name}}</h2></div><p class=\"caption-text\">{{caption}}</p><div class=\"palette\" aria-hidden=\"true\"><i style=\"background:{{palette1}}\"></i><i style=\"background:{{palette2}}\"></i><i style=\"background:{{palette3}}\"></i></div><pre class=\"prompt\" data-cc-prompt>{{prompt}}</pre><small class=\"image-note\">{{imageNote}}</small></figcaption></figure>{{/frames}}</main><footer class=\"colophon\">{{title}} · MIO EDITION</footer></article>{{/books}}</body></html>",
  "assets": {}
}
