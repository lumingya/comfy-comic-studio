{
  "id": "export-nocturne",
  "formatVersion": 1,
  "title": "暗房放映 · Nocturne",
  "description": "黑曜石舞台、香槟铜细线与影展字幕。一幕一幕，安静进入画面。",
  "author": "Mio",
  "version": "3.0.0",
  "layout": "cinema",
  "options": {
    "accent": "#c4a47c",
    "background": "#0a0b0e",
    "paper": "#111318",
    "text": "#ece7df",
    "width": 1200,
    "gap": 56,
    "radius": 0,
    "font": "serif"
  },
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{collectionTitle}}</title><style>\n:root{--accent:{{themeColor}};--paper:{{paperColor}};--ink:{{textColor}};--canvas:{{background}};--line:color-mix(in srgb,var(--ink) 20%,transparent)}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--canvas);color:var(--ink);font-family:{{bodyFont}};-webkit-font-smoothing:antialiased}figure{margin:0}p{white-space:pre-line}h1,h2,p{overflow-wrap:anywhere}h1,h2{font-weight:400}::selection{background:var(--accent);color:var(--paper)}\n.edition-heading h1{text-wrap:balance}.edition-heading p:empty,.edition-heading .signature:empty,.caption-text:empty,.image-note:empty,.prompt:empty{display:none}.prompt{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.8 ui-monospace,monospace;opacity:.65;margin:16px 0 0}.image-note{display:block;font:11px/1.6 system-ui,sans-serif;margin-top:10px;opacity:.6}.cc-image{display:block;width:auto;height:auto;max-width:100%;max-height:none;object-fit:contain;margin-inline:auto;border:{{frameBorder}}px solid var(--accent);border-radius:{{imageRadius}}px;cursor:zoom-in}.cc-image:focus-visible{outline:2px solid var(--accent);outline-offset:5px}.palette{display:flex;gap:5px}.palette i{display:block;width:8px;height:8px;flex:none}.colophon{font:10px/1.8 system-ui,sans-serif;letter-spacing:.14em}.cc-blank{min-height:240px;opacity:1;color:color-mix(in srgb,var(--ink) 25%,transparent)}\n@media print{html{scroll-behavior:auto}body{background:white;color:#1a1816}.book{max-width:none!important;margin:0!important}.frame{break-inside:avoid}.edition-heading{break-after:avoid}.cc-image{max-height:none}.palette i{print-color-adjust:exact}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}\n\n:root{color-scheme:dark}.book{max-width:{{contentWidth}}px;margin:0 auto;padding:36px clamp(16px,5vw,72px) 140px}.edition-heading{text-align:center;padding:0 0 35px}.topline{display:flex;justify-content:space-between;gap:18px;color:var(--accent);border-top:1px solid color-mix(in srgb,var(--accent) 55%,transparent);padding-top:16px;font-size:9px}.edition-heading h1{font-size:clamp(24px,3.5vw,40px);letter-spacing:.12em;line-height:1.6;margin:30px 0 12px}.synopsis{font-size:13px;line-height:1.95;max-width:42em;margin:0 auto;opacity:.62}.signature{font:11px/1.8 system-ui,sans-serif;color:var(--accent);margin:16px 0 0}.pages{display:grid;gap:{{panelGap}}px}.frame{min-width:0}.art{background:var(--paper);padding:clamp(10px,2.7vw,32px);border:1px solid #ece7df0d;box-shadow:0 18px 60px #0005}.caption{text-align:center;max-width:46em;margin:0 auto;padding:28px 16px 20px}.scene{display:flex;align-items:center;justify-content:center;gap:14px;color:var(--accent);font:10px/1.8 system-ui,sans-serif;letter-spacing:.12em}.scene:before,.scene:after{content:\"\";display:block;width:24px;height:1px;background:var(--accent);opacity:.55}.caption h2{font:inherit;font-size:11px;margin:0}.caption-text{font-size:clamp(15px,1.6vw,19px);line-height:2;letter-spacing:.045em;margin:16px 0 0;text-wrap:balance}.palette{justify-content:center;margin-top:22px}.palette i{opacity:.6}.caption .prompt{text-align:left;color:var(--ink)}.colophon.credits{border-top:1px solid #ece7df1a;color:var(--accent);text-align:center;margin-top:24px;padding-top:18px;font-size:9px}\n@media(max-width:680px){.book{padding:22px 14px 120px}.edition-heading{padding-bottom:24px}.topline{font-size:8px;letter-spacing:.08em}.edition-heading h1{margin-top:24px;letter-spacing:.06em}.synopsis{font-size:12px}.art{padding:10px}.caption{padding:22px 12px 16px}.caption-text{font-size:15px;line-height:1.95}}\n@media print{:root{color-scheme:light}.book{padding:0}.art{background:#111318;print-color-adjust:exact}.edition-heading,.caption{color:#1a1816}.frame{margin-bottom:30px}}\n</style></head><body>{{#books}}<article class=\"book nocturne\" data-cc-book data-mio-curated-edition><header class=\"edition-heading\"><div class=\"topline colophon\"><span>NOCTURNE / 暗房放映</span><span>{{date}}</span></div><h1>{{title}}</h1><p class=\"synopsis\">{{synopsis}}</p><p class=\"signature\">{{signature}}</p></header><main class=\"pages\" data-cc-pages>{{#frames}}<figure class=\"frame\" data-cc-frame><div class=\"art\"><img class=\"cc-image\" src=\"{{image}}\" alt=\"{{name}}\" loading=\"lazy\" decoding=\"async\"></div><figcaption class=\"caption\" data-cc-caption><div class=\"scene\"><span>{{number}}</span><h2>{{name}}</h2></div><p class=\"caption-text\">{{caption}}</p><div class=\"palette\" aria-hidden=\"true\"><i style=\"background:{{palette1}}\"></i><i style=\"background:{{palette2}}\"></i><i style=\"background:{{palette3}}\"></i></div><pre class=\"prompt\" data-cc-prompt>{{prompt}}</pre><small class=\"image-note\">{{imageNote}}</small></figcaption></figure>{{/frames}}</main><footer class=\"colophon credits\">{{panelCount}} FRAMES · MIO EDITION</footer></article>{{/books}}</body></html>",
  "assets": {}
}
