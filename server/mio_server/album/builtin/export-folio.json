{
  "id": "export-folio",
  "formatVersion": 1,
  "title": "精装对页 · Folio",
  "description": "亚麻展桌上的棉纸双页，中缝光影与页脚配文；窄屏自然展开为单页。",
  "author": "Mio",
  "version": "3.0.0",
  "layout": "folio",
  "options": {
    "accent": "#8b6f4c",
    "background": "#eae5dc",
    "paper": "#fdfbf6",
    "text": "#29251f",
    "width": 1320,
    "gap": 0,
    "radius": 0,
    "font": "serif"
  },
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{collectionTitle}}</title><style>\n:root{--accent:{{themeColor}};--paper:{{paperColor}};--ink:{{textColor}};--canvas:{{background}};--line:color-mix(in srgb,var(--ink) 20%,transparent)}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--canvas);color:var(--ink);font-family:{{bodyFont}};-webkit-font-smoothing:antialiased}figure{margin:0}p{white-space:pre-line}h1,h2,p{overflow-wrap:anywhere}h1,h2{font-weight:400}::selection{background:var(--accent);color:var(--paper)}\n.edition-heading h1{text-wrap:balance}.edition-heading p:empty,.edition-heading .signature:empty,.caption-text:empty,.image-note:empty,.prompt:empty{display:none}.prompt{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.8 ui-monospace,monospace;opacity:.65;margin:16px 0 0}.image-note{display:block;font:11px/1.6 system-ui,sans-serif;margin-top:10px;opacity:.6}.cc-image{display:block;width:auto;height:auto;max-width:100%;max-height:none;object-fit:contain;margin-inline:auto;border:{{frameBorder}}px solid var(--accent);border-radius:{{imageRadius}}px;cursor:zoom-in}.cc-image:focus-visible{outline:2px solid var(--accent);outline-offset:5px}.palette{display:flex;gap:5px}.palette i{display:block;width:8px;height:8px;flex:none}.colophon{font:10px/1.8 system-ui,sans-serif;letter-spacing:.14em}.cc-blank{min-height:240px;opacity:1;color:color-mix(in srgb,var(--ink) 25%,transparent)}\n@media print{html{scroll-behavior:auto}body{background:white;color:#1a1816}.book{max-width:none!important;margin:0!important}.frame{break-inside:avoid}.edition-heading{break-after:avoid}.cc-image{max-height:none}.palette i{print-color-adjust:exact}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}\n\n.book{max-width:{{contentWidth}}px;margin:38px auto 0;padding:0 clamp(16px,4vw,48px) 130px}.edition-heading{max-width:62em;margin:0 auto 30px;text-align:center}.topline{color:var(--accent);font-size:9px;letter-spacing:.2em}.edition-heading h1{font-size:clamp(25px,3vw,38px);letter-spacing:.06em;line-height:1.5;margin:18px 0 12px}.synopsis{font-size:13px;line-height:1.95;opacity:.68;max-width:42em;margin:0 auto}.signature{font:11px/1.8 system-ui,sans-serif;color:var(--accent);margin:15px 0 0}.pages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:{{panelGap}}px;align-items:stretch;filter:drop-shadow(0 15px 20px #3a2b171a)}.frame{position:relative;display:flex;flex-direction:column;min-width:0;background:var(--paper);padding:25px clamp(18px,3vw,36px) 30px;border-top:1px solid #fff8;border-bottom:1px solid #8b6f4c24}.frame:nth-child(odd){background:linear-gradient(90deg,transparent 95%,#79674712),var(--paper);box-shadow:inset -15px 0 18px -18px #44382280;border-radius:2px 0 0 2px}.frame:nth-child(even){background:linear-gradient(90deg,#79674716,transparent 5%),var(--paper);box-shadow:inset 15px 0 18px -18px #44382280;border-radius:0 2px 2px 0}.running-head{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:28px;color:var(--accent);font:9px/1.6 system-ui,sans-serif;letter-spacing:.08em}.running-head span:first-child{min-width:0;overflow-wrap:anywhere}.running-head span:last-child{flex:none;font-variant-numeric:tabular-nums}.art{margin:auto 0;min-width:0;padding-bottom:28px}.caption{border-top:1px solid var(--line);padding-top:14px;margin-top:auto;min-width:0}.caption h2{font-size:12px;line-height:1.7;margin:0 0 8px;color:var(--accent)}.caption-text{font-size:12px;line-height:1.95;margin:0}.palette{margin-top:16px}.palette i{width:8px;height:8px}.colophon.imprint{text-align:center;color:var(--accent);margin-top:27px;font-size:9px}.cc-blank{background:var(--paper);border:1px solid #8b6f4c18;box-shadow:inset 15px 0 18px -18px #44382280}\nbody[data-mio-paged] .pages[data-mio-pair] .frame{align-self:stretch}body[data-mio-paged]:not(:has([data-mio-pair])) .frame{background:var(--paper);box-shadow:0 10px 24px #3a2b170d;border-radius:2px}\n@media(max-width:680px){.book{margin-top:24px;padding:0 14px 120px}.edition-heading{margin-bottom:24px;padding-inline:8px}.edition-heading h1{margin-top:15px}.pages{grid-template-columns:1fr;filter:none;gap:18px}.frame,.frame:nth-child(odd),.frame:nth-child(even){padding:20px 22px 26px;background:var(--paper);border:1px solid #8b6f4c18;box-shadow:0 8px 20px #3a2b170b;border-radius:2px}.running-head{margin-bottom:22px}.art{padding-bottom:24px}.caption-text{font-size:13px}}\n@media print{.book{padding:0}.pages{filter:none}.frame,.frame:nth-child(odd),.frame:nth-child(even){background:white;box-shadow:none}.frame{border:0;padding:18px}.running-head{margin-bottom:18px}}\n</style></head><body>{{#books}}<article class=\"book folio\" data-cc-book data-mio-curated-edition><header class=\"edition-heading\"><div class=\"topline colophon\">FOLIO / 精装对页</div><h1>{{title}}</h1><p class=\"synopsis\">{{synopsis}}</p><p class=\"signature\">{{signature}}</p></header><main class=\"pages\" data-cc-pages>{{#frames}}<figure class=\"frame\" data-cc-frame><div class=\"running-head\" data-mio-label><span>{{title}}</span><span>{{number}} / {{total}}</span></div><div class=\"art\"><img class=\"cc-image\" src=\"{{image}}\" alt=\"{{name}}\" loading=\"lazy\" decoding=\"async\"></div><figcaption class=\"caption\" data-cc-caption><h2>{{name}}</h2><p class=\"caption-text\">{{caption}}</p><div class=\"palette\" aria-hidden=\"true\"><i style=\"background:{{palette1}}\"></i><i style=\"background:{{palette2}}\"></i><i style=\"background:{{palette3}}\"></i></div><pre class=\"prompt\" data-cc-prompt>{{prompt}}</pre><small class=\"image-note\">{{imageNote}}</small></figcaption></figure>{{/frames}}</main><footer class=\"colophon imprint\">{{date}} · {{panelCount}} PLATES · MIO EDITION</footer></article>{{/books}}</body></html>",
  "assets": {}
}
