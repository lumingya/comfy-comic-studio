{
  "id": "export-zine",
  "formatVersion": 1,
  "title": "独立志 · Zine",
  "description": "日式独立出版小志风格：轻网格、错落留白、手记式页码与可打印纸面。",
  "author": "Mio",
  "version": "1.0.0",
  "layout": "editorial",
  "options": {
    "accent": "#a64e3c",
    "background": "#e8e4dc",
    "paper": "#fbf8f0",
    "text": "#2b2926",
    "width": 1160,
    "gap": 38,
    "radius": 0,
    "font": "serif"
  },
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{collectionTitle}}</title><style>\n:root{--accent:{{themeColor}};--paper:{{paperColor}};--ink:{{textColor}};--canvas:{{background}};--rule:color-mix(in srgb,var(--ink) 24%,transparent)}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background-color:var(--canvas);background-image:repeating-linear-gradient(2deg,#786a4d08 0 1px,transparent 1px 5px),repeating-linear-gradient(92deg,#786a4d06 0 1px,transparent 1px 7px);font-family:{{bodyFont}};-webkit-font-smoothing:antialiased}figure{margin:0}h1,h2,p{overflow-wrap:anywhere}h1,h2{font-weight:400}p{white-space:pre-line}::selection{background:var(--accent);color:var(--paper)}\n.book{max-width:{{contentWidth}}px;margin:auto;padding:0 clamp(16px,4vw,48px) 120px}.edition-heading{position:relative;margin:clamp(25px,6vw,76px) 0 64px;padding:18px 0 28px;border-top:1px solid var(--ink);border-bottom:3px double var(--ink)}.mastline{display:flex;justify-content:space-between;gap:16px;color:var(--accent);font:10px/1.6 system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase}.issue{font:10px/1.6 ui-monospace,monospace;white-space:nowrap}.edition-heading h1{max-width:14ch;margin:36px 0 20px;font-size:clamp(34px,7vw,78px);line-height:1.12;letter-spacing:-.035em;text-wrap:balance}.synopsis{max-width:42em;margin:0;font-size:14px;line-height:2;opacity:.75}.signature{display:inline-block;margin:22px 0 0;padding:5px 10px;color:var(--paper);background:var(--accent);font:11px/1.5 system-ui,sans-serif;transform:rotate(-1deg)}.pages{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:{{panelGap}}px 22px;align-items:start}.frame{min-width:0;position:relative;padding:12px 12px 17px;background:var(--paper);box-shadow:0 3px 13px #30251a12;transform:rotate(-.25deg)}.frame:nth-child(4n+2){transform:rotate(.3deg);margin-top:74px}.frame:nth-child(4n+3){transform:rotate(.2deg);margin:20px 0 0 12%}.frame:nth-child(4n){transform:rotate(-.35deg);margin-top:-20px}.frame:nth-child(4n+1){grid-column:span 7}.frame:nth-child(4n+2){grid-column:span 5}.frame:nth-child(4n+3){grid-column:span 5}.frame:nth-child(4n){grid-column:span 7}.frame::before{content:\"\";position:absolute;inset:5px;border:1px solid #a64e3c16;pointer-events:none}.art{position:relative;padding:0 0 14px}.cc-image{display:block;width:auto;height:auto;max-width:100%;max-height:none;object-fit:contain;margin:0 auto;border:{{frameBorder}}px solid var(--accent);border-radius:{{imageRadius}}px;cursor:zoom-in}.cc-image:focus-visible{outline:2px solid var(--accent);outline-offset:5px}.caption{position:relative;display:grid;grid-template-columns:38px minmax(0,1fr);gap:2px 12px;padding:10px 4px 0;border-top:1px solid var(--rule)}.number{color:var(--accent);font:10px/1.7 ui-monospace,monospace}.caption h2{margin:0;font-size:13px;line-height:1.65}.caption-text{grid-column:2;margin:2px 0 0;font-size:12px;line-height:1.85}.margin-note{grid-column:2;margin:8px 0 0;color:var(--accent);font:10px/1.6 system-ui,sans-serif;letter-spacing:.05em}.prompt{grid-column:1/-1;white-space:pre-wrap;overflow-wrap:anywhere;font:10px/1.7 ui-monospace,monospace;opacity:.58;margin:12px 4px 0}.image-note{grid-column:1/-1;font:10px/1.6 system-ui,sans-serif;opacity:.6;margin:5px 4px 0}.caption-text:empty,.prompt:empty,.image-note:empty,.signature:empty{display:none}.cc-blank{min-height:240px;opacity:1;color:color-mix(in srgb,var(--ink) 26%,transparent);background:var(--paper);border:1px dashed var(--rule)}.colophon{display:flex;justify-content:space-between;gap:12px;margin-top:58px;padding-top:12px;border-top:1px solid var(--ink);font:9px/1.7 system-ui,sans-serif;letter-spacing:.1em}.colophon span:last-child{font-variant-numeric:tabular-nums}\n@media(max-width:680px){.book{padding-inline:14px;padding-bottom:100px}.edition-heading{margin:25px 0 35px}.edition-heading h1{margin-top:28px}.pages{grid-template-columns:1fr;gap:26px}.frame,.frame:nth-child(n){grid-column:1;margin:0;padding:10px 10px 14px;transform:none}.frame:nth-child(even){width:92%;margin-left:auto}.frame:nth-child(4n+3){width:88%;margin-left:0}.caption-text{font-size:13px}}\n@media print{@page{size:auto;margin:14mm}html{scroll-behavior:auto}body{background:white;background-image:none;color:#171614;-webkit-print-color-adjust:exact;print-color-adjust:exact}.book{max-width:none;padding:0}.edition-heading{margin:0 0 12mm;padding-top:8mm}.pages{gap:10mm 6mm}.frame{break-inside:avoid;box-shadow:none;border:1px solid #aaa;transform:none!important;margin:0!important}.cc-image{max-height:none}.colophon{margin-top:12mm}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}\n</style></head><body>{{#books}}<article class=\"book zine\" data-cc-book><header class=\"edition-heading\"><div class=\"mastline\"><span>SMALL PRESS / INDEPENDENT COMIC</span><span class=\"issue\">{{date}} · {{panelCount}} CUTS</span></div><h1>{{title}}</h1><p class=\"synopsis\">{{synopsis}}</p><p class=\"signature\">{{signature}}</p></header><main class=\"pages\" data-cc-pages>{{#frames}}<figure class=\"frame\" data-cc-frame><div class=\"art\"><img class=\"cc-image\" src=\"{{image}}\" alt=\"{{name}}\" loading=\"lazy\" decoding=\"async\"></div><figcaption class=\"caption\" data-cc-caption><span class=\"number\">No. {{number}}</span><h2>{{name}}</h2><p class=\"caption-text\">{{caption}}</p><p class=\"margin-note\">MARGIN NOTE · {{width}} × {{height}}</p><pre class=\"prompt\" data-cc-prompt>{{prompt}}</pre><small class=\"image-note\">{{imageNote}}</small></figcaption></figure>{{/frames}}</main><footer class=\"colophon\"><span>{{title}} · INDEPENDENT EDITION</span><span>PLATE {{panelCount}} / MIO</span></footer></article>{{/books}}</body></html>",
  "assets": {}
}
