{
 "id": "export-atelier",
 "formatVersion": 1,
 "title": "ATELIER · 展厅典藏",
 "description": "暖灰展墙、策展铭牌与克制的聚光画框。",
 "author": "Mio",
 "version": "1.0.0",
 "layout": "gallery",
 "options": {
  "accent": "#c6a77a",
  "background": "#272725",
  "paper": "#343431",
  "text": "#eee9df",
  "width": 1120,
  "gap": 40,
  "radius": 2,
  "font": "serif"
 },
 "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{collectionTitle}}</title><style>\n:root{--accent:{{themeColor}};--paper:{{paperColor}};--canvas:{{background}};--ink:{{textColor}};--line:color-mix(in srgb,var(--ink) 18%,transparent);--gap:{{panelGap}}px;--radius:{{imageRadius}}px}\n*{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--ink);font-family:{{bodyFont}}}img{display:block;max-width:100%;height:auto;margin:auto}.cc-image{display:block;width:auto;height:auto;max-width:100%;max-height:none;object-fit:contain;margin-inline:auto}h1,h2,p{margin-top:0}p{line-height:1.85}.book{max-width:{{contentWidth}}px;margin:0 auto 56px}.mast{padding:clamp(24px,6vw,72px);position:relative}.kicker,.index,.credit{font:10px/1.6 ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase}.mast h1{font-size:clamp(32px,7vw,76px);line-height:1.08;letter-spacing:.02em;margin:24px 0;overflow-wrap:anywhere}.synopsis{max-width:38em;opacity:.74}.credit{border-top:1px solid var(--line);padding-top:14px;margin-top:28px}.pages{padding:0 clamp(16px,5vw,64px);display:grid;gap:var(--gap)}.frame{min-width:0;overflow:hidden}.art{position:relative;background:var(--paper);padding:clamp(8px,1.8vw,20px);border:{{frameBorder}}px solid var(--accent);border-radius:var(--radius)}.art img{width:100%;object-fit:contain}.caption{padding:16px 2px 24px}.caption h2{font-size:16px;font-weight:500;margin:0 0 8px}.caption p{font-size:14px;margin:0}.prompt{white-space:pre-wrap;overflow-wrap:anywhere;font:10px/1.7 ui-monospace,monospace;opacity:.5;margin-top:14px}.note{font-size:11px;opacity:.55}.palette{display:flex;gap:5px;margin-top:14px}.palette i{width:22px;height:5px;border-radius:5px}.end{padding:28px 6%;border-top:1px solid var(--line);font-size:11px;letter-spacing:.08em;opacity:.55;text-align:right}.prompt:empty,.note:empty{display:none}\n@media(max-width:640px){.pages{padding:0 16px}.caption{padding:12px 0 18px}.caption p{font-size:13px}}\n@media print{body{background:white}.book{max-width:none;margin:0}.mast{break-after:avoid}.frame{break-inside:avoid}.end{break-before:page}}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}\n.book{color:var(--ink)}.mast{min-height:250px;display:flex;flex-direction:column;justify-content:end;border-bottom:1px solid #ffffff22}.kicker{color:var(--accent)}.mast h1{max-width:760px}.pages{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.frame{background:var(--paper);box-shadow:0 18px 52px #0006}.art{padding:18px;background:linear-gradient(145deg,#ffffff0b,transparent 55%)}.art img{max-height:72vh}.caption{padding:18px 22px 24px}.caption h2{color:var(--accent);letter-spacing:.08em}.end{border-color:#ffffff24}@media(max-width:720px){.pages{grid-template-columns:1fr}}\n</style></head><body>{{#books}}<article class=\"book\" data-cc-book><header class=\"mast\"><div class=\"kicker\"><span>ATELIER · MIO EDITION</span><span>{{date}}</span></div><h1>{{title}}</h1><p class=\"synopsis\">{{synopsis}}</p><div class=\"credit\">{{signature}}</div></header><main class=\"pages\" data-cc-pages>{{#frames}}<figure class=\"frame\" data-cc-frame><span class=\"index\">{{number}}</span><div class=\"art\"><img class=\"cc-image\" src=\"{{image}}\" alt=\"{{name}}\"></div><figcaption class=\"caption\" data-cc-caption><h2>{{name}}</h2><p>{{caption}}</p><pre class=\"prompt\" data-cc-prompt>{{prompt}}</pre><small class=\"note\">{{imageNote}}</small><div class=\"palette\"><i style=\"background:{{palette1}}\"></i><i style=\"background:{{palette2}}\"></i><i style=\"background:{{palette3}}\"></i></div></figcaption></figure>{{/frames}}</main><footer class=\"end\">MIO · {{panelCount}} FRAMES</footer></article>{{/books}}</body></html>",
 "assets": {}
}
