{
 "id": "export-seamless",
 "formatVersion": 1,
 "title": "无缝 · 纯图阅读",
 "description": "桌面完整画面的自适应双页与单页，手机连续阅读；不裁切、不放大小图。纯图无配文，连续模式上下零间距。",
 "author": "Mio",
 "version": "1.1.0",
 "layout": "webtoon",
 "options": {
  "accent": "#437a98",
  "background": "#f4f5f6",
  "paper": "#ffffff",
  "text": "#252a30",
  "width": 960,
  "gap": 0,
  "radius": 0,
  "font": "sans"
 },
 "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>{{collectionTitle}}</title><style>\n:root{color-scheme:light dark;background:{{background}};color:{{textColor}}}\n*{box-sizing:border-box}html,body{margin:0;padding:0;min-height:100%;border:0}\nbody{background:{{background}};font-family:system-ui,sans-serif}\n.sf-book{width:100%;max-width:{{contentWidth}}px;margin:0 auto;padding:0;border:0;background:transparent}\n.sf-pages,.sf-frame{display:block;margin:0;padding:0;border:0;border-radius:0;box-shadow:none;background:transparent;line-height:0;font-size:0}\n.sf-image{display:block;width:auto;max-width:100%;height:auto;max-height:none;margin:0 auto;padding:0;border:0;border-radius:0;box-shadow:none;object-fit:contain;vertical-align:top}\n@media(prefers-color-scheme:dark){:root,body{background:#14171a;color:#e5e7eb}}\n@media print{:root,body{background:#fff}.sf-book{max-width:100%}.sf-frame{break-inside:avoid}}\n</style></head><body data-mio-seamless>\n{{#books}}<article class=\"sf-book\" data-cc-book aria-label=\"{{title}}\"><main class=\"sf-pages\" data-cc-pages>\n{{#frames}}<figure class=\"sf-frame\" data-cc-frame><img class=\"sf-image\" src=\"{{image}}\" alt=\"{{title}} · 第 {{number}} 幕\" loading=\"lazy\" decoding=\"async\"></figure>{{/frames}}\n</main></article>{{/books}}\n</body></html>"
}