{
  "visibility": {
    "gallery": true,
    "storyboard": true,
    "matrix": true,
    "engine": true,
    "llm": false,
    "logs": true,
    "extensions": true,
    "marketplace": false
  },
  "features": {
    "assistant": true,
    "visualCritic": true,
    "executionLogs": true
  },
  "appearance": {
    "theme": "dark",
    "density": "comfortable",
    "reduceMotion": false,
    "showMetrics": true
  },
  "reader": {
    "defaultMode": "focus"
  },
  "export": {
    "templateId": "export-paper",
    "showCaptions": true,
    "showPrompts": false,
    "border": 0
  },
  "assistant": {
    "confirmChanges": true
  },
  "shell": {
    "collapsed": false
  }
}
